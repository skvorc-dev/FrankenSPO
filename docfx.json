{
  "build": {
    "content": [
      {
        "files": [
          "**/*.md"
        ],
        "src": "site"
      }
    ],
    "resource": [
      {
        "files": [
          "assets/**"
        ],
        "src": "site"
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern",
      "site-theme"
    ],
    "globalMetadata": {
      "_appTitle": "FrankenSPO",
      "_appName": "FrankenSPO",
      "_enableSearch": true,
      "_appFooter": "FrankenSPO by Sferix · Early development",
      "_appLogoPath": "assets/logo.svg",
      "_appLogoUrl": "/",
      "_appFaviconPath": "assets/favicon.svg",
      "_lang": "en"
    }
  }
}
